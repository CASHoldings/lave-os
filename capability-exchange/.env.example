# Copy to .env.local and adjust. Never commit real secrets.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo: fictional data and one-click demo sign-in (refused when NODE_ENV=production).
# standard: real accounts only.
APP_MODE=demo
APP_URL=http://localhost:3000

# Required in production: a long random string (32+ characters), e.g. `openssl rand -base64 48`.
# Signs file download links. Sessions are random tokens stored hashed in the database.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string (Supabase: Project Settings > Database > connection string).
# Leave empty locally to use the embedded PGlite database in PGLITE_DIR (demo/development only).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# password: built-in email + password (scrypt hashes in this database).
# supabase: Supabase Auth checks passwords; needs SUPABASE_URL and SUPABASE_ANON_KEY.
AUTH_PROVIDER=password

# ---------------------------------------------------------------------------
# Evidence file storage (always private)
# ---------------------------------------------------------------------------
# local: files under LOCAL_STORAGE_DIR, served only through signed one-minute links.
# supabase: a private Supabase Storage bucket; needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=10

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# ---------------------------------------------------------------------------
# AI assistance (optional)
# ---------------------------------------------------------------------------
# anthropic: live suggestions (needs ANTHROPIC_API_KEY). demo: labelled demonstration
# responses (development only). none: assistant switched off. If unset: anthropic when a
# key is present, demo in demo mode, otherwise none.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=30000
AI_HOURLY_LIMIT=30
