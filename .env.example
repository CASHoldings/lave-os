# Copy to .env and fill in. All settings use the LAVE_ prefix.
LAVE_ENV=production
LAVE_DATABASE_URL=postgresql+psycopg://lave:CHANGE_ME@db-host:5432/lave_os

# Long random strings: python -c "import secrets; print(secrets.token_hex(32))"
LAVE_SECRET_KEY=
# Same value goes in WordPress (wp-config.php: define('LAVE_OS_SSO_SECRET', '...');)
LAVE_WP_SSO_SECRET=

# Public address of the site (must be https in production: it also marks sign-in cookies as secure)
LAVE_SITE_URL=https://lavelondon.com
# Outgoing email for sign-in links (Postmark, Amazon SES, etc. over SMTP)
LAVE_SMTP_HOST=
LAVE_SMTP_PORT=587
LAVE_SMTP_USER=
LAVE_SMTP_PASSWORD=
LAVE_MAIL_FROM=LAVE <care@lavelondon.com>

LAVE_WP_LOGIN_URL=https://lavelondon.com/my-account/
LAVE_CORS_ORIGINS=["https://lavelondon.com","https://www.lavelondon.com"]

# Stripe (Dashboard → Developers → API keys). Use test keys until launch.
LAVE_STRIPE_SECRET_KEY=
LAVE_STRIPE_PUBLISHABLE_KEY=
LAVE_STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (price_...) for each monthly membership
LAVE_STRIPE_PRICE_ESSENCE=
LAVE_STRIPE_PRICE_ELEVATE=
LAVE_STRIPE_PRICE_ECLAT=
# Annual prices (£290, £590, £1,290)
LAVE_STRIPE_PRICE_ESSENCE_ANNUAL=
LAVE_STRIPE_PRICE_ELEVATE_ANNUAL=
LAVE_STRIPE_PRICE_ECLAT_ANNUAL=

# Booking rules
LAVE_BOOKING_HORIZON_DAYS=21
LAVE_BOOKING_MIN_NOTICE_MINUTES=120
LAVE_TURNAROUND_HOURS=24
LAVE_CANCEL_CUTOFF_MINUTES=120
